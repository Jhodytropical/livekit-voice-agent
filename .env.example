# Copy to .env.local and fill in. NEVER commit the filled file.
# Every value below is a placeholder. No real credential belongs in this file.

# ---- LiveKit (required to run the agent against a room / browser playground) ----
# From https://cloud.livekit.io -> Project -> Settings -> Keys
LIVEKIT_URL=wss://REPLACE-ME.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME

# ---- Speech-to-text: Deepgram ----
DEEPGRAM_API_KEY=REPLACE_ME

# ---- LLM + text-to-speech: OpenAI ----
OPENAI_API_KEY=REPLACE_ME

# ---- Optional model overrides (safe defaults are used when unset) ----
# DEEPGRAM_STT_MODEL=nova-3
# OPENAI_LLM_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=ash

# ---- Turn-taking / barge-in tuning (seconds unless noted) ----
# See README "Barge-in findings" for what each of these actually changed.
# INTERRUPTION_MIN_DURATION=0.4
# INTERRUPTION_MIN_WORDS=2
# FALSE_INTERRUPTION_TIMEOUT=2.0
# ENDPOINTING_MIN_DELAY=0.4
# ENDPOINTING_MAX_DELAY=3.0

# ---- Tool runtime bounds (agency limits — see README threat model) ----
# TOOL_MAX_ATTEMPTS=3
# TOOL_BACKOFF_BASE_SECONDS=0.2
# TOOL_BACKOFF_MAX_SECONDS=2.0
# TOOL_TIMEOUT_SECONDS=5.0
