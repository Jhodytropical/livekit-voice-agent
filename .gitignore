# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Model caches downloaded at runtime (Silero VAD, turn detector)
.cache/
models/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local run logs — may contain caller names/numbers. Never commit.
logs/

# Local edit backups — never publish. The trailing * matters: the convention in this
# project is `file.md.bak.20260728`, which a bare `*.bak` pattern does not match.
*.bak
*.bak.*
*.bak[0-9]*

# Scratch dir used when a tool cannot unlink (device-bridge mounts refuse rm).
_to_delete/
